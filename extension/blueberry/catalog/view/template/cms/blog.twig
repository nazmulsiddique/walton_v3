{{ header }}
<div id="product-category">
  <!-- Breadcrumb -->
  <section class="section-breadcrumb mb-[20px] max-[1199px]:mb-[15px] border-b border-solid border-[#eee] bg-[#f8f8fb]">
      <div class="flex flex-wrap justify-between relative items-center mx-auto min-[1400px]:max-w-[1320px] min-[1200px]:max-w-[1140px] min-[992px]:max-w-[960px] min-[768px]:max-w-[720px] min-[576px]:max-w-[540px]">
          <div class="flex flex-wrap w-full">
              <div class="w-full px-[12px]">
                  <div class="flex flex-wrap w-full bb-breadcrumb-inner m-0 py-[20px] items-center">
                      <!-- Breadcrumb List -->
                      <div class="w-full px-[12px]">
                          <ul class="bb-breadcrumb-list mx-[-5px] flex justify-start max-[767px]:justify-center flex-wrap">
                              <li class="bb-breadcrumb-item text-[14px] font-normal px-[5px]"><a href="{{ base }}" class="font-Poppins text-[14px] leading-[28px] tracking-[0.03rem] font-semibold text-[#686e7d]"> Home</a></li>
                              {% for breadcrumb in breadcrumbs %}
                                  {% if not loop.first %}
                                      <li class="text-[14px] font-normal px-[5px]">
                                          <i class="ri-arrow-right-double-fill text-[14px] font-semibold leading-[28px]"></i>
                                      </li>
                                  {% endif %}
                                  <li class="bb-breadcrumb-item px-[5px]">
                                      {% if loop.last %}
                                          <span class="font-Poppins text-[#686e7d] text-[14px] leading-[28px] font-normal tracking-[0.03rem]">
                                              {{ breadcrumb.text }}
                                          </span>
                                      {% else %}
                                          <a href="{{ breadcrumb.href }}"
                                            class="font-Poppins text-[14px] leading-[28px] tracking-[0.03rem] font-semibold text-[#686e7d] hover:text-[#3bb77e] transition-all duration-300">
                                              {{ breadcrumb.text }}
                                          </a>
                                      {% endif %}
                                  </li>
                              {% endfor %}
                          </ul>
                      </div>
                  </div>
              </div>
          </div>
      </div>
  </section> 
<div class="mx-auto max-w-[1320px] px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
        <main id="content" class="flex-1 min-w-0">

            {{ content_top }}

            <h1 class="mb-6 text-3xl font-bold text-[#222]">
                {{ heading_title }}
            </h1>

            {% if image %}
                <img
                    src="{{ image }}"
                    alt="{{ heading_title }}"
                    title="{{ heading_title }}"
                    class="mb-6 w-full rounded-2xl border border-gray-200 shadow-sm">
            {% endif %}

            {% if description %}
                <div class="prose max-w-none mb-8">
                    {{ description }}
                </div>
            {% endif %}

            <div class="my-8 border-t border-gray-200"></div>

            <h3 class="mb-5 text-2xl font-semibold">
                {{ text_refine }}
            </h3>

            <!-- Search -->
            <div class="mb-8 flex flex-col gap-4 lg:flex-row">

                <input
                    type="text"
                    name="search"
                    value="{{ search }}"
                    placeholder="{{ entry_search }}"
                    id="input-search"
                    class="flex-1 rounded-xl border border-gray-300 px-4 py-3 outline-none focus:border-[#6c7fd8]">

                {% if topics %}
                    <select
                        name="topic_id"
                        id="input-topic"
                        class="rounded-xl border border-gray-300 px-4 py-3 outline-none focus:border-[#6c7fd8]">

                        <option value="">{{ text_all }}</option>

                        {% for topic in topics %}
                            <option value="{{ topic.topic_id }}"{% if topic.topic_id == topic_id %} selected{% endif %}>
                                {{ topic.name }}
                            </option>
                        {% endfor %}

                    </select>
                {% endif %}

                <button
                    id="button-search"
                    class="rounded-xl bg-[#6c7fd8] px-8 py-3 text-white transition hover:bg-[#5b6ecc]">
                    {{ button_search }}
                </button>

            </div>

            <!-- Sort -->
            <div class="mb-8 flex justify-end">

                <div class="flex items-center gap-3">

                    <label for="input-sort" class="font-medium">
                        {{ text_sort }}
                    </label>

                    <select
                        id="input-sort"
                        onchange="location=this.value"
                        class="rounded-xl border border-gray-300 px-4 py-2 outline-none focus:border-[#6c7fd8]">

                        {% for sorts in sorts %}
                            <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>
                                {{ sorts.text }}
                            </option>
                        {% endfor %}

                    </select>

                </div>

            </div>

            {% if articles %}
                <div class="grid grid-cols-1 sm:grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
                  {% for article in articles %}
                      <article class="mb-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:shadow-lg">
                          <h2 class="mb-4 text-2xl font-semibold">
                              <a href="{{ article.href }}" class="hover:text-[#6c7fd8]">
                                  {{ article.name }}
                              </a>
                          </h2>
                          {% if article.image %}
                              <a href="{{ article.href }}">
                                  <img
                                      src="{{ article.image }}"
                                      alt="{{ article.name }}"
                                      title="{{ article.name }}"
                                      class="mb-5 w-full rounded-xl">
                              </a>
                          {% endif %}
                          <p class="mb-5 leading-7 text-gray-600">
                              {{ article.description }}
                          </p>
                          <div class="flex justify-end">
                              <a
                                  href="{{ article.href }}"
                                  class="rounded-xl bg-[#6c7fd8] px-6 py-3 text-white transition hover:bg-[#5b6ecc]">
                                  {{ button_continue }}
                              </a>
                          </div>
                      </article>
                  {% endfor %}
                </div>  
                <div class="mt-10 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

                    <div class="text-center md:text-left">
                        {{ pagination }}
                    </div>

                    <div class="text-center md:text-right">
                        {{ results }}
                    </div>

                </div>

            {% else %}

                <p class="py-12 text-center text-lg text-gray-500">
                    {{ text_no_results }}
                </p>

            {% endif %}

            {{ content_bottom }}

        </main>
    </div>
</div>
</div>
<script type="text/javascript"><!--
$('#button-search').bind('click', function() {
    url = 'index.php?route=cms/blog&language={{ language }}';

    var search = $('#input-search').val();

    if (search) {
        url += '&search=' + encodeURIComponent(search);
    }

    var topic_id = $('#input-topic').prop('value');

    if (topic_id > 0) {
        url += '&topic_id=' + topic_id;
    }

    location = url;
});

$('#input-search').bind('keydown', function(e) {
    if (e.keyCode == 13) {
        $('#button-search').trigger('click');
    }
});
//--></script>
{{ footer }}
<style>
#input-sort{
   display:block !important;
}
</style>