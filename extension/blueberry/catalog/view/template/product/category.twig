{{ header }}
<div id="product-category" class="max-w-[1320px] mx-auto">
    {% set content_class = 'col-span-12' %}
    {% if column_left and column_right %}
        {% set content_class = 'col-span-12 lg:col-span-6' %}
    {% elseif column_left or column_right %}
        {% set content_class = 'col-span-12 lg:col-span-9' %}
    {% endif %}
  <!-- Breadcrumb -->
  <section class="section-breadcrumb mb-[20px] max-[1199px]:mb-[15px] border-b border-solid border-[#eee] bg-[#f8f8fb]">
      <div class="flex flex-wrap justify-between relative items-center mx-auto min-[1400px]:max-w-[1320px] min-[1200px]:max-w-[1140px] min-[992px]:max-w-[960px] min-[768px]:max-w-[720px] min-[576px]:max-w-[540px]">
          <div class="flex flex-wrap w-full">
              <div class="w-full px-[12px]">
                  <div class="flex flex-wrap w-full bb-breadcrumb-inner m-0 py-[20px] items-center">
                      <!-- Breadcrumb List -->
                      <div class="w-full px-[12px]">
                          <ul class="bb-breadcrumb-list mx-[-5px] flex justify-start max-[767px]:justify-center flex-wrap">
                              <li class="bb-breadcrumb-item text-[14px] font-normal px-[5px]"><a href="{{ base }}" class="font-Poppins text-[14px] leading-[28px] tracking-[0.03rem] font-semibold text-[#686e7d]"> Home</a></li>
                              {% for breadcrumb in breadcrumbs %}
                                  {% if not loop.first %}
                                      <li class="text-[14px] font-normal px-[5px]">
                                          <i class="ri-arrow-right-double-fill text-[14px] font-semibold leading-[28px]"></i>
                                      </li>
                                  {% endif %}
                                  <li class="bb-breadcrumb-item px-[5px]">
                                      {% if loop.last %}
                                          <span class="font-Poppins text-[#686e7d] text-[14px] leading-[28px] font-normal tracking-[0.03rem]">
                                              {{ breadcrumb.text }}
                                          </span>
                                      {% else %}
                                          <a href="{{ breadcrumb.href }}"
                                            class="font-Poppins text-[14px] leading-[28px] tracking-[0.03rem] font-semibold text-[#686e7d] hover:text-[#3bb77e] transition-all duration-300">
                                              {{ breadcrumb.text }}
                                          </a>
                                      {% endif %}
                                  </li>
                              {% endfor %}
                          </ul>
                      </div>
                  </div>
              </div>
          </div>
      </div>
  </section> 
    {{ content_top }}

    
    <!-- Category section -->
    <section class="section-category pt-[10px] max-[1199px]:pt-[15px] mb-[15px]">
        <div class="flex flex-wrap justify-between relative items-center mx-auto min-[1400px]:max-w-[1320px] min-[1200px]:max-w-[1140px] min-[992px]:max-w-[960px] min-[768px]:max-w-[720px] min-[576px]:max-w-[540px]">
            <div class="flex flex-wrap w-full">
                <div class="w-full px-[12px]">
                    <div class="bb-category-5-colum owl-carousel">
                    {# Background color classes to rotate #}
                    {% set bg_classes = [
                        'bg-[#fef1f1]',
                        'bg-[#e1fcf2]',
                        'bg-[#f4f1fe]',
                        'bg-[#e1fcf2]',
                        'bg-[#fbf9e4]'
                    ] %}
                    {% for category in categories %}
                        {% set bg_class = bg_classes[loop.index0 % bg_classes|length] %}
                        {% set delay = loop.index * 200 %}
                        <div class="bb-category-box p-[15px] rounded-[20px] flex flex-col items-center text-center max-[1399px]:p-[20px] {{ bg_class }}"
                             data-aos="flip-left"
                             data-aos-duration="1000"
                             data-aos-delay="{{ delay }}">
                            <!-- Category Image -->
                            <div class="category-image mb-[12px]">
                                {% if category.thumb is defined and category.thumb %}
                                    <img src="{{ category.thumb }}"
                                         alt="{{ category.name }}"
                                         class="w-[150px] h-[150px] object-contain
                                                max-[1399px]:h-[65px] max-[1399px]:w-[65px]
                                                max-[1199px]:h-[50px] max-[1199px]:w-[50px]">
                                {% else %}
                                    <img src="extension/blueberry/catalog/view/img/no-image/no_image.png"
                                         alt="{{ category.name }}"
                                         class="w-[150px] h-[150px] object-contain
                                                max-[1399px]:h-[65px] max-[1399px]:w-[65px]
                                                max-[1199px]:h-[50px] max-[1199px]:w-[50px]">
                                {% endif %}
                            </div>
                            <!-- Category Content -->
                            <div class="category-sub-contact">
                                <h5 class="mb-[2px] text-[16px] font-quicksand text-[#3d4750] font-semibold tracking-[0.03rem] leading-[1.2] h-[35px]">
                                    <a href="{{ category.href }}"
                                       class="font-Poppins text-[16px] font-medium leading-[1.2] tracking-[0.03rem] text-[#3d4750] capitalize hover:text-[#3bb77e] transition-all duration-300">
                                        {{ category.name }}
                                    </a>
                                </h5>
                                {% if category.product_count is defined %}
                                    <p class="font-Poppins text-[13px] text-[#686e7d] leading-[25px] font-light tracking-[0.03rem]">
                                        {{ category.product_count }} items
                                    </p>
                                {% endif %}
                            </div>

                        </div>
                    {% endfor %}

                </div>
                </div>
            </div>
        </div>
    </section>
    <div class="grid grid-cols-12 gap-6">

        {% if column_left %}
            <aside id="mobile_filter_content_top" class="col-span-12 lg:col-span-3 hidden lg:block">
                <div class="w-full">
                    <div class="bb-pro-list-top mb-[24px] rounded-[20px] flex bg-[#f8f8fb] border-[1px] border-solid border-[#eee] justify-between">
                        <div class="flex lg:flex-wrap justify-between w-full">
                              <a href="{{ compare }}"
                                  id="compare-total"
                                  class="inline-flex items-center gap-2 px-4 py-4 text-dark rounded-md transition duration-200">
                                      <i class="ri-arrow-left-right-line text-lg"></i>
                                      <span class="hidden xl:inline">
                                          {{ text_compare }}
                                      </span>
                              </a>
                        </div>
                    </div>
                </div>
                <div id="column_left_content" class="bb-shop-wrap bg-[#f8f8fb] border border-solid border-[#eee] rounded-[20px] sticky top-0 p-[20px]">
                    <div class="rounded-xl border border-gray-200 bg-white p-4 mb-5">
                        <!-- Title -->
                        <div class="mb-2 flex items-center justify-between">
                            <h3 class="font-quicksand text-base font-bold text-[#3d4750]">
                                Price Range
                            </h3>
                            <span class="rounded-full bg-[#6c7fd8]/10 px-2 py-0.5 text-[10px] font-semibold text-[#6c7fd8]">
                                Filter
                            </span>
                        </div>
                        <!-- Slider -->
                        <div class="mb-2">
                            <div id="slider-range"
                                 data-min="{{ price_range.min|default(0) }}"
                                 data-max="{{ price_range.max|default(0) }}"
                                 data-value-min="{{ price_min|default('') }}"
                                 data-value-max="{{ price_max|default('') }}"></div>
                        </div>
                        <!-- Price -->
                        <div class="mb-2">
                            <input
                                id="amount"
                                type="text"
                                readonly
                                class="h-8 w-full rounded-lg border border-gray-200 bg-gray-50 px-3 text-center text-sm font-semibold text-gray-700 outline-none">
                        </div>
                        <!-- Buttons -->
                        <div class="flex gap-2">
                            <button
                                id="apply-price"
                                class="flex-1 rounded-lg bg-[#6c7fd8] px-3 py-1 text-sm font-medium text-white transition hover:bg-[#5b6ecc]">
                                Apply
                            </button>
                            <button
                                id="reset-price"
                                class="rounded-lg border border-[#6c7fd8] px-4 py-1 text-sm font-medium text-[#6c7fd8] transition hover:bg-[#6c7fd8] hover:text-white">
                                Reset
                            </button>
                        </div>

                    </div>

                    {{ column_left }}
                </div>
            </aside>
        {% endif %}

        <div class="
            {% if column_left and column_right %}
                col-span-12 lg:col-span-6
            {% elseif column_left or column_right %}
                col-span-12 lg:col-span-9
            {% else %}
                col-span-12
            {% endif %}
        ">
            <div id="category-products" class="px-2">
                {{ products_html }}
            </div>
        </div>

        {% if column_right %}
            <aside class="col-span-12 lg:col-span-3">
                {{ column_right }}
            </aside>
        {% endif %}

    </div>

    {{ content_bottom }}
    
</div>
</div>
{{ footer }}
<script>
    document.addEventListener('submit', function (e) {

        const form = e.target;

        if (!form.matches('[data-oc-toggle="ajax"]')) return;

        setTimeout(() => {

            // refresh compare total
            fetch('index.php?route=product/compare|info'.replace('|',''))
                .then(res => res.text())
                .then(html => {
                    const temp = document.createElement('div');
                    temp.innerHTML = html;

                    const newCompare = temp.querySelector('#compare-total');

                    if (newCompare) {
                        document.querySelector('#compare-total').innerHTML =
                            newCompare.innerHTML;
                    }
                });

        }, 300);

    });

    (function () {
        var baseUrl = "{{ ajax_base_url|escape('js') }}";

        window.buildFilterUrl = function () {
            var filter = [];

            if (window.jQuery) {
                jQuery('input[name^=\'filter\']:checked').each(function () {
                    filter.push(this.value);
                });
            }

            var url = baseUrl;

            if (filter.length > 0) {
                url += '&filter=' + filter.join(',');
            }

            if (window.bbPriceFilter && window.bbPriceFilter.min !== null && window.bbPriceFilter.min !== undefined) {
                url += '&price_min=' + window.bbPriceFilter.min;
            }

            if (window.bbPriceFilter && window.bbPriceFilter.max !== null && window.bbPriceFilter.max !== undefined) {
                url += '&price_max=' + window.bbPriceFilter.max;
            }

            return url;
        };

        window.loadCategoryProducts = function (url) {
            if (!window.jQuery) { return; }

            var separator = url.indexOf('?') > -1 ? '&' : '?';
            var ajaxUrl = url + separator + 'ajax=1';

            jQuery('#category-products').css('opacity', '0.5');
            jQuery('input[name^=\'filter\'], #input-sort, #input-limit').prop('disabled', true);

            jQuery.ajax({
                url: ajaxUrl,
                type: 'get',
                dataType: 'json',
                success: function (json) {
                    if (json['success']) {
                        jQuery('#category-products').html(json['html']);
                        if (typeof json['column_left'] !== 'undefined') {
                            jQuery('#column_left_dynamic').html(json['column_left']);
                        }

                        history.pushState({}, '', url);
                    }
                },
                error: function () {},
                complete: function () {
                    jQuery('#category-products').css('opacity', '1');
                    jQuery('input[name^=\'filter\'], #input-sort, #input-limit').prop('disabled', false);
                    jQuery('#input-sort, #input-limit').addClass('block');
                    jQuery('#category-products .pro-bb-content').removeClass('width-100');
                }
            });
        };

        window.addEventListener('popstate', function () {
            var url = window.location.href;
            url = url.replace(/[&?]ajax=\d/, '');
            window.loadCategoryProducts(url);
        });

        if (window.jQuery) {
            jQuery(document).on('change', '#input-sort', function () {
                window.loadCategoryProducts(this.value);
            });

            jQuery(document).on('change', '#input-limit', function () {
                window.loadCategoryProducts(this.value);
            });

            jQuery(document).on('click', '.pagination a', function (e) {
                e.preventDefault();
                window.loadCategoryProducts(jQuery(this).attr('href'));
            });
        }
    })();

    // Price range filter (Apply/Reset buttons in the sidebar card above).
    (function () {
        var initialMin = "{{ price_min|default('') }}";
        var initialMax = "{{ price_max|default('') }}";

        window.bbPriceFilter = {
            min: initialMin !== '' ? parseFloat(initialMin) : null,
            max: initialMax !== '' ? parseFloat(initialMax) : null
        };

        var applyBtn = document.getElementById('apply-price');
        var resetBtn = document.getElementById('reset-price');
        var slider = document.getElementById('slider-range');

        function reload() {
            window.loadCategoryProducts(window.buildFilterUrl());
        }

        if (applyBtn && slider) {
            applyBtn.addEventListener('click', function () {
                if (!window.jQuery || !jQuery(slider).hasClass('ui-slider')) { return; }

                var values = jQuery(slider).slider('values');

                window.bbPriceFilter = { min: values[0], max: values[1] };

                reload();
            });
        }

        if (resetBtn && slider) {
            resetBtn.addEventListener('click', function () {
                if (!window.jQuery || !jQuery(slider).hasClass('ui-slider')) { return; }

                var min = parseInt(jQuery(slider).data('min'), 10) || 0;
                var max = parseInt(jQuery(slider).data('max'), 10) || 0;

                jQuery(slider).slider('values', [min, max]);
                jQuery('#amount').val('৳' + min + ' - ৳' + max);

                window.bbPriceFilter = { min: null, max: null };

                reload();
            });
        }
    })();
</script>
<style>
#input-sort{
   display:block !important;
}
</style>