{% if products %}
<div class="bb-related-products w-full">
    <h3 class="text-[18px] font-bold text-[#3d4750] mb-[16px] pb-[10px] border-b border-solid border-[#eee]">
        {{ text_related is defined ? text_related : 'Related Products' }}
    </h3>
    <div class="flex flex-col">
        {% for product in products %}
        {{ product }}
        {% endfor %}
    </div>
</div>
{% endif %}


